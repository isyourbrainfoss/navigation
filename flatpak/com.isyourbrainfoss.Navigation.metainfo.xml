<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.isyourbrainfoss.Navigation</id>
  <name>Navigation</name>
  <summary>Simple multi-platform OSM navigation</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer_name>isyourbrainfoss</developer_name>
  <description>
    <p>
      A simple, user-friendly navigation app with beautiful maps, walk and drive
      routing, fuzzy place search, and offline map regions.
    </p>
    <p>
      Built for Android phones, Linux desktop, and Linux phones. Map data from
      OpenStreetMap; search via Photon; routing via OSRM.
    </p>
  </description>
  <launchable type="desktop-id">com.isyourbrainfoss.Navigation.desktop</launchable>
  <url type="homepage">https://github.com/isyourbrainfoss/navigation</url>
  <url type="bugtracker">https://github.com/isyourbrainfoss/navigation/issues</url>
  <provides>
    <binary>navigation</binary>
  </provides>
  <categories>
    <category>Maps</category>
    <category>Navigation</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.0" date="2026-07-15"/>
  </releases>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
</component>
